[
    {
        "key": "aboutAlertHubTitle",
        "namespace": "about",
        "value": "مرفق الإنذار التابع للاتحاد الدولي لجمعيات الصليب الأحمر والهلال الأحمر - نبذة"
    },
    {
        "key": "aboutDisclaimerDescription",
        "namespace": "about",
        "value": "ينشر مرفق الإنذار التابع للاتحاد الدولي لجمعيات الصليب الأحمر والهلال الأحمر فقط التنبيهات الرسمية الصادرة عن وكالات التنبيه الحكومية المعترف بها، ولا يصدر الاتحاد الدولي لجمعيات الصليب الأحمر والهلال الأحمر أو الجمعيات الوطنية الأعضاء فيه التنبيهات أو ينشرها، ولا يتحمل الاتحاد الدولي لجمعيات الصليب الأحمر والهلال الأحمر أي مسؤولية عن المعلومات الواردة في التنبيهات، التي تقع فقط على عاتق الوكالة المصدرة لها، ويبذل الاتحاد الدولي لجمعيات الصليب الأحمر والهلال الأحمر قصارى جهده لتحديد خلاصات التنبيهات الحكومية المعطلة وتسليط الضوء على هذه المعلومات لمستخدمي مرفق الإنذار، ومع ذلك ، لا يراقب الاتحاد الدولي لجمعيات الصليب الأحمر والهلال الأحمر حالة الخلاصات الحكومية على مدار اليوم والساعة وتقع على عاتق مستخدمي المرفق مسؤولية تحديد المصادر الإضافية لمعلومات تنبيهات الأخطار."
    },
    {
        "key": "aboutDisclaimerTitle",
        "namespace": "about",
        "value": "إخلاء المسؤولية"
    },
    {
        "key": "aboutGoalDescription",
        "namespace": "about",
        "value": "الهدف من مرفق الإنذار التابع للاتحاد الدولي لجمعيات الصليب الأحمر والهلال الأحمر هو ضمان حصول المجتمعات المحلية في كل مكان على أكثر تنبيهات حالات الطوارئ فعالية في الوقت المناسب، وبالتالي التصرف لحماية حياتها وسبل عيشها."
    },
    {
        "key": "aboutProblemFactorsIncluding",
        "namespace": "about",
        "value": "يرجع هذا الإخفاق في الوصول إلى الناس إلى عدة عوامل، منها:"
    },
    {
        "key": "aboutSolutionStep1",
        "namespace": "about",
        "value": "زيادة وصول وسائل الإعلام والشبكات الإلكترونية إلى التنبيهات الحكومية الرسمية المنشورة باستخدام بروتوكول الإنذار الموحد (CAP)، وهو نسق رقمي لتبادل الإنذارات في حالات الطوارئ، مما يسمح بنشر رسالة إنذار متسقة في وقت واحد عبر مسارات اتصالات متعددة"
    },
    {
        "key": "aboutSolutionStep2",
        "namespace": "about",
        "value": "تيسير إقران تنبيهات الأخطار الصادرة باستخدام بروتوكول الإنذار الموحد مع رسائل التوعية العامة والتثقيف العام السياقية والقابلة للتنفيذ محليًا التي تصدرها وتوافق عليها الحكومات الوطنية ومنظمات إدارة حالات الطوارئ."
    },
    {
        "key": "aboutSolutionSteps",
        "namespace": "about",
        "value": "سيتم ذلك عن طريق ما يلي:"
    },
    {
        "key": "aboutTheGoalTitile",
        "namespace": "about",
        "value": "الهدف"
    },
    {
        "key": "aboutTheProblemActionableGuidance",
        "namespace": "about",
        "value": "عدم وجود إرشادات قابلة للتنفيذ يمكن للناس فهمها والوثوق بها حول كيفية الحفاظ على سلامتهم؛"
    },
    {
        "key": "aboutTheProblemDescription",
        "namespace": "about",
        "value": "كل عام، يتعرض الملايين من الناس للتقل أو الإصابة أو النزوح أو يصبحون فقراء بسبب الكوارث الطبيعية التي كان يمكن منع آثارها أو الحد منها، ويرجع الكثير من هذه الخسائر إلى عدم فعالية التحذيرات العامة: تنبيهات الطوارئ التي لا تصدر في الوقت المناسب بما فيه الكفاية أو يصعب فهمها أو تخفق في الوصول إلى جميع المعرضين للخطر."
    },
    {
        "key": "aboutTheProblemHazardInformation",
        "namespace": "about",
        "value": "عدم الإعلان عن مصادر الإخطار بفعالية أو اتساق؛"
    },
    {
        "key": "aboutTheProblemLimitedBroadcasting",
        "namespace": "about",
        "value": "البث المحدود لتنبيهات الأخطار عبر عدد قليل جدًا من قنوات الاتصال."
    },
    {
        "key": "aboutTheProblemOverlyComplicated",
        "namespace": "about",
        "value": "الرسائل المعقدة للغاية والمثقلة بالبيانات غير المناسبة للسياق والتي لا يمكن للجمهور العام فهمها؛"
    },
    {
        "key": "aboutTheProblemTitle",
        "namespace": "about",
        "value": "المشكلة"
    },
    {
        "key": "aboutTheSolutionDescription",
        "namespace": "about",
        "value": "يهدف مرفق الإنذار التابع للاتحاد الدولي لجمعيات الصليب الأحمر والهلال الأحمر إلى معالجة هذا الوضع من خلال الاستفادة من تكنولوجيا الاتصالات الحديثة والمعايير الدولية التي أثبتت جدواها لزيادة تقديم تنبيهات حالات الطوارئ الموثوق بها والقابلة للتنفيذ وتشجيع اتخاذ الأشخاص المعرضين للخطر لإجراءات استباقية."
    },
